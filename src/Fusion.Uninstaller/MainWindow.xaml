<Window x:Class="Fusion.Uninstaller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fusion Manager" Height="560" Width="760" MinHeight="520" MinWidth="700" WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#F5F4FF">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="FUSION MANAGER" FontSize="27" FontWeight="Bold" Foreground="#B8AEFF"/>
        <TextBlock Text="Your Geometry Dash installation, managed in one place." Foreground="#AAB2CC" Margin="0,5,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#19233A" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
        <TextBlock Text="WINDOWS • x64" Foreground="#B8AEFF" FontSize="11" FontWeight="Bold"/>
      </Border>
    </DockPanel>
    <Border Grid.Row="1" Background="#151B2B" BorderBrush="#303B59" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="GAME INSTALLATION" Foreground="#8F9AB8" FontSize="11" FontWeight="Bold"/>
          <TextBox x:Name="GamePathBox" Margin="0,8,12,0" Padding="9" Background="#0B1020" Foreground="White" BorderBrush="#3A4563"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Detect" Click="Detect_Click" Padding="18,8" VerticalAlignment="Bottom" Background="#273451" Foreground="White" BorderBrush="#46577D"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <Border Background="#151B2B" BorderBrush="#303B59" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="FUSION STATUS" Foreground="#8F9AB8" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="InstallStatusText" Text="Checking installation…" FontSize="20" FontWeight="SemiBold" Foreground="#F5F4FF" Margin="0,9,0,5"/>
            <TextBlock x:Name="VersionText" Text="Installed version: unknown" Foreground="#AAB2CC" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="#151B2B" BorderBrush="#303B59" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="RELEASE UPDATES" Foreground="#8F9AB8" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="ReleaseText" Text="Check GitHub for the latest official release." Foreground="#D9DDF0" TextWrapping="Wrap" Margin="0,9,0,14"/>
            <Button x:Name="UpdateButton" Content="Check for Updates" Click="Update_Click" Padding="12,10" Background="#7768D8" Foreground="White" BorderBrush="#988BFF" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <Border Background="#151B2B" BorderBrush="#303B59" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="MAINTENANCE" Foreground="#8F9AB8" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Repair or remove Fusion without touching your original Geometry Dash files." Foreground="#D9DDF0" TextWrapping="Wrap" Margin="0,9,0,14"/>
            <Button Content="Repair / Reinstall Fusion" Click="Repair_Click" Padding="12,9" Margin="0,0,0,9" Background="#273451" Foreground="White" BorderBrush="#46577D"/>
            <Button Content="Uninstall Fusion" Click="Remove_Click" Padding="12,9" Background="#452B3A" Foreground="#FFDCE4" BorderBrush="#865064"/>
          </StackPanel>
        </Border>
        <Border Background="#151B2B" BorderBrush="#303B59" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="ACTIVITY" Foreground="#8F9AB8" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="#B8AEFF" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="Fusion Manager • Updates are delivered through official Fusion GitHub releases." Foreground="#65718E" FontSize="11" Margin="2,18,0,0"/>
  </Grid>
</Window>