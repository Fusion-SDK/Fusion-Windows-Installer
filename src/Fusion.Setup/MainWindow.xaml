<Window x:Class="Fusion.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusion Setup" Height="560" Width="820"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource SetupBackground}" Foreground="#F5F4FF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#111A30" Padding="26">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FUSION" FontSize="34" FontWeight="Bold" Foreground="#B8AEFF"/>
                <TextBlock Text="CIRCLE" FontSize="13" Foreground="#9BA6C5" Margin="3,0,0,25"/>
                <TextBlock Text="A better home for your mods." TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Fusion Installer for Windows" Foreground="#AAB2CC" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StepTitle" Text="Welcome to Fusion Setup" FontSize="27" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock x:Name="StepDescription" Text="This wizard will install Fusion Installer for your Windows account." Foreground="#AAB2CC" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,24"/>
                <TextBlock Text="Install location" FontWeight="SemiBold"/>
                <TextBox x:Name="InstallPathBox" Text="{Binding DefaultInstallPath}" Padding="10" Background="#111A30" Foreground="White" BorderBrush="#3A4563" Margin="0,8,0,8"/>
                <Button Content="Use recommended location" HorizontalAlignment="Left" Click="DefaultPath_Click" Background="#293452"/>
                <TextBlock x:Name="StatusText" Foreground="#B8AEFF" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>
            <DockPanel Grid.Row="1" LastChildFill="False">
                <Button Content="Cancel" DockPanel.Dock="Left" Width="100" Click="Cancel_Click" Background="#293452"/>
                <Button Content="Install" DockPanel.Dock="Right" Width="130" Click="Install_Click"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
