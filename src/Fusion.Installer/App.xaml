<Application x:Class="Fusion.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="FusionBackground">#0B1020</Color>
        <Color x:Key="FusionSurface">#151D32</Color>
        <Color x:Key="FusionAccent">#8B7CFF</Color>
        <SolidColorBrush x:Key="FusionBackgroundBrush" Color="{StaticResource FusionBackground}"/>
        <SolidColorBrush x:Key="FusionSurfaceBrush" Color="{StaticResource FusionSurface}"/>
        <SolidColorBrush x:Key="FusionAccentBrush" Color="{StaticResource FusionAccent}"/>
        <SolidColorBrush x:Key="FusionTextBrush" Color="#F4F5FF"/>
        <SolidColorBrush x:Key="FusionMutedBrush" Color="#AAB2CC"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#6557D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1426"/>
            <Setter Property="Foreground" Value="#F4F5FF"/>
            <Setter Property="BorderBrush" Value="#34405D"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0D1426"/>
            <Setter Property="Foreground" Value="#F4F5FF"/>
            <Setter Property="BorderBrush" Value="#34405D"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>
    </Application.Resources>
</Application>
