<Window x:Class="Fusion.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusion Installer" Height="760" Width="1180"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FusionBackgroundBrush}"
        Foreground="{StaticResource FusionTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#10182B" Padding="22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FUSION" FontSize="25" FontWeight="Bold" Foreground="#B9B0FF"/>
                    <TextBlock Text="CIRCLE MODDING" FontSize="10" Foreground="{StaticResource FusionMutedBrush}" Margin="2,0,0,30"/>
                    <Button Content="Overview" Click="Overview_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Mod Browser" Click="Mods_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="My Mods" Click="MyMods_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Games" Click="Games_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Settings" Click="Settings_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="ConnectionLabel" Text="Not connected" Foreground="{StaticResource FusionMutedBrush}" TextWrapping="Wrap" Margin="0,12"/>
                    <TextBlock Text="Fusion Installer 0.1.0" Foreground="#77819D" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Your Geometry Dash modding hub." Foreground="{StaticResource FusionMutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Sign in" Click="ShowAuth_Click" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
